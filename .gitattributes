# Normalizar texto a LF en Git y en nuevos checkouts.
# Estas reglas no convierten la codificacion de caracteres.
* text=auto eol=lf

# Scripts nativos de Windows.
*.bat text eol=crlf
*.cmd text eol=crlf

# Artefactos binarios: conservar sus bytes sin conversiones.
*.xsa binary
*.bit binary
*.bin binary
*.BIN binary
*.bin_old binary
*.binmal binary
*.elf binary
*.o binary
*.a binary
*.zip binary
*.rar binary
*.7z binary
*.xlsx binary

# Mantener los bytes heredados durante el refactor. Normalizacion aplazada.
src/** -text
config/lwip211/*.c -text

# Paquetes externos: todos los payloads deben conservar el SHA-256 del productor.
# Incluye LTX y ps7_init (C/H/Tcl/HTML), aunque sean texto.
artifacts/** -text
artifacts/**/README.md text eol=lf
artifacts/**/manifest.json text eol=lf
artifacts/dependencies-lock.json text eol=lf
